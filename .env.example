# Eltako Device Configuration Template
ELTAKO_HOST=192.168.1.100
ELTAKO_PORT=443
ELTAKO_POP=your_proof_of_possession_code

# Optional Home Assistant Local Deployment & Testing Settings
# Path to your local Home Assistant configuration directory:
# HA_CONFIG_DIR=~/.homeassistant
# Or for Docker/remote mount:
# HA_CONFIG_DIR=/path/to/homeassistant/config

# Optional Remote Deployment (via SSH/rsync/scp):
# HA_REMOTE=root@homeassistant.local:/config

# Optional Home Assistant API (enables automatic config check and restart with --restart):
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token_here
